# ---- Backend ----
# Comma-separated key pool (at least 2). Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-groq-key,your-gemini-key
# Model for every key, unless LLM_MODELS below gives one per key.
LLM_MODEL=groq/openai/gpt-oss-20b
# Optional: one LiteLLM model per key, in key order (lets the pool span providers).
# key_1 = Groq key, key_2 = Gemini key in this example.
LLM_MODELS=groq/openai/gpt-oss-20b,gemini/gemini-3.5-flash-lite
# Optional: custom OpenAI-compatible endpoint (leave empty for the provider default)
LLM_API_BASE=
# Per-key call timeout before failing over to the next key
LLM_TIMEOUT_SECONDS=30
# How long cached responses live (in-memory LiteLLM cache)
CACHE_TTL_SECONDS=3600

# SQLite file location. docker-compose pins this to the /data volume.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test header (must be true on the deployed backend)
ENABLE_FAILURE_SIMULATION=true

# ---- Frontend (build-time) ----
# Public URL of the backend as seen from the browser
VITE_API_URL=http://localhost:8000
